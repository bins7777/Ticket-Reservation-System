<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="620.0" prefWidth="920.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="movieticketreservation.MovieTicketListController">
   <children>
      <Button fx:id="movieTicketList_close" layoutX="870.0" layoutY="10.0" onAction="#handleClose" prefHeight="24.0" prefWidth="40.0" styleClass="close" stylesheets="@designDashboard.css" text="X" />
      <Button fx:id="movieTicketList_minimize" layoutX="820.0" layoutY="10.0" onAction="#handleMinimize" prefHeight="24.0" prefWidth="40.0" styleClass="close" stylesheets="@designDashboard.css" text="-" />
      <Button fx:id="movieTicketList_backButton" layoutX="30.0" layoutY="25.0" mnemonicParsing="false" onAction="#handleBack" prefHeight="32.0" prefWidth="118.0" styleClass="login-btn" stylesheets="@designDashboard.css" text="Back">
         <font>
            <Font name="Bell MT" size="25.0" />
         </font>
      </Button>

      <AnchorPane layoutX="27.0" layoutY="73.0" prefHeight="518.0" prefWidth="851.0" styleClass="bg-shadow" stylesheets="@designDashboard.css">
         <children>
            <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="30.0" prefHeight="456.0" prefWidth="810.0" spacing="30.0">
               <children>
                  <ImageView fx:id="posterImage" fitHeight="420.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="true" styleClass="bg-shadow" />
                  <VBox prefWidth="500.0" spacing="12.0">
                     <children>
                        <Text fx:id="movieTitle" strokeType="OUTSIDE" strokeWidth="0.0" text="Movie Title" wrappingWidth="420.0">
                           <font>
                              <Font name="Berlin Sans FB" size="40.0" />
                           </font>
                        </Text>
                        <Text fx:id="movieMetadata" fill="#9e9e9e" strokeType="OUTSIDE" strokeWidth="0.0" text="Year | Genre" wrappingWidth="420.0">
                           <font>
                              <Font name="Berlin Sans FB" size="20.0" />
                           </font>
                        </Text>
                        <Text fx:id="movieRuntime" fill="#797979" strokeType="OUTSIDE" strokeWidth="0.0" text="Run Time: 0m" wrappingWidth="420.0">
                           <font>
                              <Font name="Berlin Sans FB Demi Bold" size="18.0" />
                           </font>
                        </Text>
                        <Text fx:id="ticketPriceText" fill="#4CAF50" strokeType="OUTSIDE" strokeWidth="0.0" text="Ticket Price: -" wrappingWidth="420.0">
                           <font>
                              <Font name="Berlin Sans FB Demi Bold" size="18.0" />
                           </font>
                        </Text>
                        <TextArea fx:id="movieSynopsis" editable="false" prefHeight="120.0" wrapText="true" />
                        <TextField fx:id="branchSearchField" promptText="Search Branch" styleClass="bg-outline" stylesheets="@designDashboard.css" />
                         <TableView fx:id="showtimeTable" prefHeight="200.0" prefWidth="480.0" VBox.vgrow="ALWAYS">
                            <columns>
                               <TableColumn fx:id="priceColumn" prefWidth="120.0" text="Ticket Price" />
                               <TableColumn fx:id="branchColumn" prefWidth="140.0" text="Branch" />
                               <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
                              <TableColumn fx:id="timeColumn" prefWidth="120.0" text="Time" />
                              <TableColumn fx:id="seatsColumn" prefWidth="120.0" text="Seats" />
                            </columns>
                         </TableView>
                         <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Double-click a schedule or use Select Seats to continue." wrappingWidth="320.0">
                                   <font>
                                      <Font name="Berlin Sans FB" size="14.0" />
                                   </font>
                                </Text>
                               <Button fx:id="selectSeatsButton" mnemonicParsing="false" onAction="#handleSelectSeats" prefHeight="36.0" prefWidth="150.0" styleClass="login-btn" stylesheets="@designDashboard.css" text="Select Seats" disable="true">
                                  <font>
                                     <Font name="Bell MT" size="20.0" />
                                  </font>
                               </Button>
                            </children>
                         </HBox>
                     </children>
                     <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
