<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="960.0" stylesheets="@foodSelection.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="movieticketreservation.FoodSelectionController">
   <children>
      <Button fx:id="backButton" layoutX="32.0" layoutY="26.0" mnemonicParsing="false" onAction="#handleBack"
              prefHeight="40.0" prefWidth="120.0" styleClass="nav-button" text="Back" />
      <Button layoutX="868.0" layoutY="26.0" mnemonicParsing="false" onAction="#handleClose"
              prefHeight="24.0" prefWidth="36.0" styleClass="window-control" text="X" />
      <Button layoutX="822.0" layoutY="26.0" mnemonicParsing="false" onAction="#handleMinimize"
              prefHeight="24.0" prefWidth="36.0" styleClass="window-control" text="-" />
      <Label fx:id="pageTitle" alignment="CENTER" layoutX="220.0" layoutY="26.0" prefWidth="520.0"
             styleClass="page-title" text="Food Options" />
      <Button fx:id="confirmOrderButton" layoutX="784.0" layoutY="78.0" mnemonicParsing="false"
              onAction="#handleConfirmOrder" prefHeight="44.0" prefWidth="144.0"
              styleClass="primary-button" text="Confirm" />

      <Label fx:id="movieTitleLabel" alignment="CENTER_LEFT" layoutX="32.0" layoutY="80.0"
             prefWidth="520.0" styleClass="movie-title" text="Movie Title" />
      <Label fx:id="showtimeLabel" alignment="CENTER_LEFT" layoutX="32.0" layoutY="110.0"
             prefWidth="520.0" styleClass="showtime-label" text="Branch - Date - Time" />

      <ScrollPane fx:id="menuScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                  layoutX="32.0" layoutY="150.0" prefHeight="440.0" prefWidth="600.0"
                  styleClass="menu-scroll">
         <content>
            <FlowPane fx:id="menuFlowPane" hgap="18.0" vgap="18.0" prefWrapLength="560.0">
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
               </padding>
            </FlowPane>
         </content>
      </ScrollPane>

      <AnchorPane fx:id="cartPane" layoutX="656.0" layoutY="150.0" prefHeight="440.0" prefWidth="272.0"
                  styleClass="cart-pane">
         <children>
            <Label layoutX="20.0" layoutY="20.0" styleClass="cart-title" text="Cart" />
            <VBox fx:id="cartItemsBox" layoutX="20.0" layoutY="60.0" prefHeight="280.0" prefWidth="232.0"
                  spacing="12.0" styleClass="cart-items">
               <padding>
                  <Insets bottom="8.0" left="2.0" right="2.0" top="2.0" />
               </padding>
            </VBox>
            <Region layoutX="20.0" layoutY="352.0" prefHeight="1.5" prefWidth="232.0" styleClass="divider" />
            <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="368.0" prefWidth="232.0" spacing="12.0">
               <children>
                  <Label styleClass="total-label" text="Total:" />
                  <Label fx:id="cartTotalLabel" styleClass="total-amount" text="₱ 0.00" />
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
